# Local SQLite database. The file will be created by Prisma migrations.
DATABASE_URL="file:./dev.db"

# Replace this value before using the API outside local development.
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# API server
PORT=1337
HOST="0.0.0.0"
FRONTEND_ORIGIN="http://localhost:5173"
PUBLIC_URL="http://localhost:1337"

# Optional: used by `npm run db:seed` to create/promote an administrator.
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-admin-password"
