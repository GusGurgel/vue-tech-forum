generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  email        String         @unique
  passwordHash String
  role         String         @default("authenticated")
  blocked      Boolean        @default(false)
  imageId      Int?
  image        UploadedFile?  @relation("UserImage", fields: [imageId], references: [id], onDelete: SetNull)
  threads      Thread[]       @relation("ThreadAuthor")
  responses    Response[]     @relation("ResponseAuthor")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([role])
  @@index([blocked])
}

model UploadedFile {
  id          Int      @id @default(autoincrement())
  name        String
  filename    String   @unique
  mimeType    String
  size        Int
  url         String
  users       User[]   @relation("UserImage")
  createdAt   DateTime @default(now())
}

model ThreadSet {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  threads     Thread[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Thread {
  id          Int        @id @default(autoincrement())
  title       String
  isFixed     Boolean    @default(false)
  threadSetId Int
  threadSet   ThreadSet  @relation(fields: [threadSetId], references: [id], onDelete: Cascade)
  authorId    Int
  author      User       @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  responses   Response[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([threadSetId])
  @@index([authorId])
  @@index([createdAt])
}

model Response {
  id        Int      @id @default(autoincrement())
  content   String
  threadId  Int
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("ResponseAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId])
  @@index([authorId])
  @@index([createdAt])
}
